# Environment
APP_ENV=production
APP_TIMEZONE=Asia/Riyadh

# Database
# Neon PostgreSQL (free tier)
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# Gmail OAuth (per-account credentials are stored in the database)
# These are the Google Cloud OAuth Client credentials
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your-client-secret

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Monitoring
POLL_INTERVAL=60s
NOTIFICATION_POLL_INTERVAL=5s

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# HTTP Server
HTTP_PORT=8080
HTTP_API_KEY=change-this-to-a-strong-api-key

# Retry Policy
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_BACKOFF=30s
RETRY_MAX_BACKOFF=15m
